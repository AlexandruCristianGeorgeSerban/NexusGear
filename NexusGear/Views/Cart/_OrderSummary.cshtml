@model NexusGear.ViewModels.CartSummaryViewModel

<div class="nexus-card-static p-4 sticky-top" style="top: 90px;">
    <h3 class="h5 fw-bold text-white mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-receipt text-mint"></i> Order Summary
    </h3>

    <div class="d-flex justify-content-between text-muted mb-2">
        <span id="summarySubtotalLabel">Items Subtotal (@Model.TotalItemsCount)</span>
        <span id="summarySubtotal" class="text-white fw-bold">@Model.Subtotal.ToString("N2") RON</span>
    </div>

    <div class="d-flex justify-content-between text-muted mb-2">
        <span>Estimated Shipping</span>
        <span id="summaryShipping">
            @if (Model.ShippingFee == 0)
            {
                <span class="badge badge-mint fw-bold">FREE</span>
            }
            else
            {
                <span class="text-white">@Model.ShippingFee.ToString("N2") RON</span>
            }
        </span>
    </div>

    <div class="d-flex justify-content-between text-muted small mb-3">
        <span>Includes 19% Romanian VAT</span>
        <span id="summaryVat">@Model.EstimatedVat.ToString("N2") RON</span>
    </div>

    <hr class="border-secondary border-opacity-50 my-3" />

    <div class="d-flex justify-content-between align-items-baseline mb-4">
        <span class="h6 fw-bold text-white mb-0">Total</span>
        <span id="summaryGrandTotal" class="h4 fw-bold text-mint mb-0">@Model.GrandTotal.ToString("N2") <span class="fs-6 text-white">RON</span></span>
    </div>

    @if (Model.HasStockIssues)
    {
        <div class="alert alert-warning small p-2 mb-3 bg-dark border-warning text-warning">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> Please adjust quantities for items exceeding stock before proceeding.
        </div>
    }

    <a asp-controller="Checkout" asp-action="Index" class="btn btn-tech w-100 py-3 fw-bold @(Model.HasStockIssues ? "disabled" : "")">
        Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
    </a>

    <!-- Reassurance Trust Badges -->
    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 small text-muted">
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-shield-check text-mint"></i>
            <span>Secure SSL Encrypted Checkout</span>
        </div>
        <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-arrow-repeat text-info"></i>
            <span>14-Day Hassle-Free EU Return Guarantee</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-patch-check text-warning"></i>
            <span>2-Year Official Manufacturer Warranty</span>
        </div>
    </div>
</div>

