@model NexusGear.ViewModels.OrderHistoryListViewModel
@{
    ViewData["Title"] = "Order History & Tracking — NexusGear";
}

<div class="container py-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 py-2">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Profile" class="text-decoration-none text-muted">My Account</a></li>
            <li class="breadcrumb-item active text-mint" aria-current="page">Order History</li>
        </ol>
    </nav>

    <!-- Page Header & Stats -->
    <div class="nexus-card-static p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h1 class="h3 fw-bold text-white mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-box-seam-fill text-mint"></i> My Orders &amp; Delivery Tracking
                </h1>
                <p class="text-muted small mb-0">Track real-time shipment progression, review past hardware purchases, and access receipts.</p>
            </div>
            <div class="d-flex gap-3">
                <div class="px-3 py-2 rounded bg-dark border border-secondary border-opacity-50 text-center">
                    <span class="text-muted small d-block">Total Orders</span>
                    <strong class="h5 text-white mb-0">@Model.TotalOrders</strong>
                </div>
                <div class="px-3 py-2 rounded bg-dark border border-secondary border-opacity-50 text-center">
                    <span class="text-muted small d-block">Total Invested</span>
                    <strong class="h5 text-mint mb-0">@Model.TotalSpent.ToString("N2") <span class="fs-6 text-muted">RON</span></strong>
                </div>
            </div>
        </div>

        <!-- Filter Pills -->
        <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top border-secondary border-opacity-25">
            <span class="text-muted small align-self-center me-2">Filter status:</span>
            @{
                var filters = new[] { "All", "Unpaid", "Paid", "Shipped", "Delivered", "Cancelled" };
            }
            @foreach (var filter in filters)
            {
                bool isActive = string.Equals(Model.CurrentFilter, filter, StringComparison.OrdinalIgnoreCase);
                <a asp-action="Index" asp-route-status="@filter"
                   class="btn btn-sm @(isActive ? "btn-tech" : "btn-outline-secondary text-muted") py-1 px-3 rounded-pill fw-medium">
                    @filter
                </a>
            }
        </div>
    </div>

    <!-- Orders Ledger -->
    @if (!Model.Orders.Any())
    {
        <div class="nexus-card-static p-5 text-center my-4">
            <i class="bi bi-inbox text-muted display-4 d-block mb-3"></i>
            <h4 class="text-white fw-bold mb-2">No orders found</h4>
            <p class="text-muted small mb-4">
                @if (Model.CurrentFilter != "All")
                {
                    <span>You do not have any orders matching status <strong>@Model.CurrentFilter</strong>.</span>
                }
                else
                {
                    <span>You haven't placed any hardware gear orders yet. Build your dream setup today!</span>
                }
            </p>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-tech py-2 px-4 fw-bold">
                <i class="bi bi-grid-fill me-2"></i> Browse Product Catalog
            </a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model.Orders)
            {
                <div class="nexus-card-static p-4 border border-secondary border-opacity-50 position-relative">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 border-bottom border-secondary border-opacity-25 gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div>
                                <span class="text-muted small d-block">Order Reference</span>
                                <span class="fw-bold font-monospace text-mint fs-5">@order.OrderNumber</span>
                            </div>
                            <div class="ms-2">
                                @if (order.Status == "Paid")
                                {
                                    <span class="badge bg-success text-white px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i> Paid</span>
                                }
                                else if (order.Status == "Shipped")
                                {
                                    <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-truck me-1"></i> Shipped</span>
                                }
                                else if (order.Status == "Delivered")
                                {
                                    <span class="badge bg-primary text-white px-2 py-1"><i class="bi bi-patch-check-fill me-1"></i> Delivered</span>
                                }
                                else if (order.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger text-white px-2 py-1"><i class="bi bi-x-circle-fill me-1"></i> Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-clock-history me-1"></i> Unpaid</span>
                                }
                            </div>
                        </div>

                        <div class="text-md-end">
                            <span class="text-muted small d-block">Placed on</span>
                            <span class="text-white small">@order.OrderDate.ToString("dd MMM yyyy, HH:mm")</span>
                        </div>
                    </div>

                    <!-- Items Preview Row -->
                    <div class="row align-items-center py-3 g-3">
                        <div class="col-md-8">
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                @foreach (var item in order.Items.Take(4))
                                {
                                    <div class="d-flex align-items-center gap-2 p-2 rounded bg-dark border border-secondary border-opacity-25">
                                        <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded object-fit-contain bg-black" style="width: 44px; height: 44px;" />
                                        <div class="small" style="max-width: 160px;">
                                            <div class="text-white text-truncate fw-medium">@item.ProductName</div>
                                            <span class="text-muted">Qty: @item.Quantity &times; @item.UnitPrice.ToString("N2") RON</span>
                                        </div>
                                    </div>
                                }
                                @if (order.Items.Count > 4)
                                {
                                    <span class="badge bg-dark border border-secondary text-muted p-2">
                                        +@(order.Items.Count - 4) more item(s)
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="col-md-4 text-md-end">
                            <span class="text-muted small d-block">Order Total</span>
                            <div class="h4 fw-bold text-mint mb-2">
                                @order.TotalAmount.ToString("N2") <span class="fs-6 text-white">RON</span>
                            </div>
                            <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-outline-mint btn-sm px-3 fw-bold">
                                View Details &amp; Tracking <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
