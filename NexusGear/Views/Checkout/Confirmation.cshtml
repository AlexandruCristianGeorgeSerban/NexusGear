@model NexusGear.ViewModels.OrderConfirmationViewModel
@{
    ViewData["Title"] = $"Order {Model.OrderNumber} Confirmed - NexusGear";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Success Notification Card -->
            <div class="nexus-card-static text-center p-5 mb-4 position-relative overflow-hidden">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-dark border border-success mb-3 shadow" style="width: 80px; height: 80px;">
                    <i class="bi bi-check-lg text-mint fs-1"></i>
                </div>
                <h1 class="h3 fw-bold text-white mb-2">Thank You, @Model.CustomerName!</h1>
                <p class="text-muted fs-6 mb-3">Your order has been recorded and placed in our fulfillment queue.</p>
                
                <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded bg-dark border border-secondary border-opacity-50">
                    <span class="text-muted small">Order Reference:</span>
                    <span class="fw-bold text-mint font-monospace fs-5">@Model.OrderNumber</span>
                    <span class="badge bg-warning text-dark fw-bold ms-2">@Model.Status</span>
                </div>
            </div>

            <!-- Order Details Card -->
            <div class="nexus-card-static p-4 mb-4">
                <div class="row g-4">
                    <!-- Delivery Info -->
                    <div class="col-md-6 border-end-md border-secondary border-opacity-25">
                        <h6 class="text-mint fw-bold mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill"></i> Delivery Destination
                        </h6>
                        <div class="text-white fw-bold mb-1">@Model.CustomerName</div>
                        <div class="text-muted small mb-1">@Model.Street</div>
                        <div class="text-muted small mb-2">@Model.City, jud. @Model.County (@Model.PostalCode)</div>
                        <div class="text-muted small mb-3"><i class="bi bi-telephone me-1 text-mint"></i> @Model.Phone</div>

                        <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 small text-muted">
                            <span class="text-white fw-bold">Courier:</span> @Model.ShippingMethod 
                            (@(Model.ShippingCost == 0 ? "FREE" : $"{Model.ShippingCost:N2} RON"))
                        </div>
                    </div>

                    <!-- Payment & Date Info -->
                    <div class="col-md-6">
                        <h6 class="text-mint fw-bold mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-credit-card-2-front-fill"></i> Order Summary & Timeline
                        </h6>
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Placed Date:</span>
                            <span class="text-white">@Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Recipient Email:</span>
                            <span class="text-white">@Model.CustomerEmail</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Payment Stage:</span>
                            <span class="badge bg-secondary text-white">Awaiting Stripe Test Session</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.DiscountCode))
                        {
                            <div class="d-flex justify-content-between text-mint small mb-1">
                                <span>Promo Voucher:</span>
                                <span class="fw-bold">@Model.DiscountCode (-@Model.DiscountAmount.ToString("N2") RON)</span>
                            </div>
                        }

                        <hr class="border-secondary border-opacity-25 my-2" />

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-white fw-bold">Total Amount:</span>
                            <span class="h5 fw-bold text-mint mb-0">@Model.TotalAmount.ToString("N2") RON</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Purchased Products Ledger -->
            <div class="nexus-card-static p-4 mb-4">
                <h6 class="text-white fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-box-seam-fill text-mint"></i> Ordered Gear Items (@Model.Items.Sum(i => i.Quantity))
                </h6>

                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle">
                        <thead>
                            <tr class="text-muted small border-secondary">
                                <th scope="col">Product</th>
                                <th scope="col" class="text-center">Quantity</th>
                                <th scope="col" class="text-end">Unit Price</th>
                                <th scope="col" class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr class="border-secondary border-opacity-25">
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded bg-dark" style="width: 48px; height: 48px; object-fit: cover;" />
                                            <div>
                                                <div class="text-white fw-bold small">@item.ProductName</div>
                                                <div class="text-muted small" style="font-size: 0.75rem;">Verified snapshotted price</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center text-white fw-bold">@item.Quantity</td>
                                    <td class="text-end text-muted small">@item.UnitPrice.ToString("N2") RON</td>
                                    <td class="text-end text-mint fw-bold">@item.LineTotal.ToString("N2") RON</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="border-top border-secondary">
                                <td colspan="3" class="text-end text-muted small">Subtotal:</td>
                                <td class="text-end text-white fw-bold">@Model.Subtotal.ToString("N2") RON</td>
                            </tr>
                            <tr>
                                <td colspan="3" class="text-end text-muted small">Delivery:</td>
                                <td class="text-end text-white">@(Model.ShippingCost == 0 ? "FREE" : $"{Model.ShippingCost:N2} RON")</td>
                            </tr>
                            @if (Model.DiscountAmount > 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-end text-mint small">Discount (@Model.DiscountCode):</td>
                                    <td class="text-end text-mint fw-bold">-@Model.DiscountAmount.ToString("N2") RON</td>
                                </tr>
                            }
                            <tr class="border-top border-secondary">
                                <td colspan="3" class="text-end text-white fw-bold fs-6">Total:</td>
                                <td class="text-end text-mint fw-bold fs-5">@Model.TotalAmount.ToString("N2") RON</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                    <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                </a>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-tech px-4 py-2 fw-bold">
                    <i class="bi bi-box-seam me-1"></i> Track Order in History
                </a>
            </div>
        </div>
    </div>
</div>
