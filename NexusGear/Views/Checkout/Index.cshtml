@model NexusGear.ViewModels.CheckoutIndexViewModel
@{
    ViewData["Title"] = "Secure Checkout - NexusGear";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index" class="text-decoration-none text-muted">Shopping Cart</a></li>
            <li class="breadcrumb-item active text-white" aria-current="page">Secure Checkout</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h2 fw-bold text-white mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-mint"></i> Secure Checkout
            </h1>
            <p class="text-muted small mb-0">Complete your shipping address and delivery details to finalize your battlestation equipment order.</p>
        </div>
        <div>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center px-3 py-2">
                <i class="bi bi-arrow-left me-1"></i> Return to Cart
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 bg-dark border-danger text-danger" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left Column: Checkout Steps 1, 2, 3 -->
            <div class="col-lg-8">
                <!-- ========================================================= -->
                <!-- Step 1: Delivery Address -->
                <!-- ========================================================= -->
                <div class="nexus-card-static mb-4 p-4">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                        <span class="badge badge-mint rounded-circle p-2 px-3 fw-bold fs-6">1</span>
                        <h2 class="h5 fw-bold text-white mb-0">Delivery Address</h2>
                    </div>

                    @if (Model.SavedAddresses.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label-nexus fw-bold text-white mb-2">Select a Saved Address</label>
                            <div class="row g-3" id="savedAddressesContainer">
                                @foreach (var addr in Model.SavedAddresses)
                                {
                                    <div class="col-12">
                                        <label class="nexus-card p-3 d-flex align-items-start gap-3 cursor-pointer w-100 position-relative @(addr.AddressId == Model.SelectedAddressId ? "border-primary" : "")" style="cursor: pointer;">
                                            <input type="radio" name="SelectedAddressId" value="@addr.AddressId" class="form-check-input mt-1 address-radio" @(addr.AddressId == Model.SelectedAddressId ? "checked" : "") />
                                            <div class="flex-grow-1">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold text-white">@addr.Street</span>
                                                    @if (addr.IsDefault)
                                                    {
                                                        <span class="badge badge-blue small">Default</span>
                                                    }
                                                </div>
                                                <p class="text-muted small mb-1">@addr.City, jud. @addr.County (@addr.PostalCode)</p>
                                                <div class="text-muted small"><i class="bi bi-telephone me-1 text-mint"></i> @addr.Phone</div>
                                            </div>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Toggle button for new address -->
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="UseNewAddress" value="true" id="useNewAddressToggle" @(Model.UseNewAddress ? "checked" : "") />
                            <label class="form-check-label text-white small" for="useNewAddressToggle">
                                <i class="bi bi-plus-circle me-1 text-mint"></i> Ship to a different / new address
                            </label>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="UseNewAddress" value="true" />
                        <div class="alert alert-info small bg-dark border-info text-info mb-3">
                            <i class="bi bi-info-circle me-1"></i> You don't have any saved shipping addresses yet. Please enter your delivery address below:
                        </div>
                    }

                    <!-- New Address Input Form Fields -->
                    <div id="newAddressFields" style="display: @(Model.SavedAddresses.Any() && !Model.UseNewAddress ? "none" : "block");" class="p-3 rounded bg-dark border border-secondary border-opacity-25 mt-3">
                        <h6 class="text-mint fw-bold mb-3"><i class="bi bi-geo-alt-fill me-1"></i> New Shipping Address</h6>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="NewAddress.Street" class="form-label-nexus">Street & Number <span class="text-danger">*</span></label>
                                <input asp-for="NewAddress.Street" class="form-control form-control-nexus" placeholder="Str. Eroilor nr. 10, bl. A1, ap. 4" />
                                <span asp-validation-for="NewAddress.Street" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewAddress.City" class="form-label-nexus">City <span class="text-danger">*</span></label>
                                <input asp-for="NewAddress.City" class="form-control form-control-nexus" placeholder="Craiova" />
                                <span asp-validation-for="NewAddress.City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewAddress.County" class="form-label-nexus">County (Județ) <span class="text-danger">*</span></label>
                                <input asp-for="NewAddress.County" class="form-control form-control-nexus" placeholder="Dolj" />
                                <span asp-validation-for="NewAddress.County" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewAddress.PostalCode" class="form-label-nexus">Postal Code <span class="text-danger">*</span></label>
                                <input asp-for="NewAddress.PostalCode" class="form-control form-control-nexus" placeholder="200100" />
                                <span asp-validation-for="NewAddress.PostalCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NewAddress.Phone" class="form-label-nexus">Phone Number <span class="text-danger">*</span></label>
                                <input asp-for="NewAddress.Phone" class="form-control form-control-nexus" placeholder="+40721000000" />
                                <span asp-validation-for="NewAddress.Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="NewAddress.IsDefault" class="form-check-input" />
                                    <label asp-for="NewAddress.IsDefault" class="form-check-label text-muted small">Save this address as my default delivery address</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================================= -->
                <!-- Step 2: Shipping Method -->
                <!-- ========================================================= -->
                <div class="nexus-card-static mb-4 p-4">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                        <span class="badge badge-mint rounded-circle p-2 px-3 fw-bold fs-6">2</span>
                        <h2 class="h5 fw-bold text-white mb-0">Delivery Method</h2>
                    </div>

                    <div class="row g-3" id="shippingOptionsContainer">
                        @foreach (var option in Model.ShippingOptions)
                        {
                            bool isSelected = option.Method == Model.SelectedShippingMethod;
                            <div class="col-md-6">
                                <label class="nexus-card p-3 d-flex flex-column h-100 cursor-pointer w-100 position-relative @(isSelected ? "border-primary" : "")" style="cursor: pointer;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="radio" name="ShippingMethod" value="@option.Method" class="form-check-input shipping-radio" @(isSelected ? "checked" : "") data-price="@option.Price" />
                                            <span class="fw-bold text-white">@option.Method</span>
                                        </div>
                                        <div>
                                            @if (option.IsFree)
                                            {
                                                <span class="badge badge-mint fw-bold">FREE</span>
                                            }
                                            else
                                            {
                                                <span class="fw-bold text-mint">@option.Price.ToString("N2") RON</span>
                                            }
                                        </div>
                                    </div>
                                    <p class="text-muted small mb-2 flex-grow-1">@option.Description</p>
                                    <div class="text-info small"><i class="bi bi-clock-history me-1"></i> @option.EstimatedDelivery</div>
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <!-- ========================================================= -->
                <!-- Step 3: Promo / Discount Code (B5) -->
                <!-- ========================================================= -->
                <div class="nexus-card-static mb-4 p-4">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                        <span class="badge badge-mint rounded-circle p-2 px-3 fw-bold fs-6">3</span>
                        <h2 class="h5 fw-bold text-white mb-0">Promo Code or Voucher</h2>
                    </div>

                    <p class="text-muted small mb-3">Have a discount voucher from our campaigns? Enter your code below (e.g. <span class="badge bg-dark border border-info text-info font-monospace">NEXUS10</span> for 10% off or <span class="badge bg-dark border border-mint text-mint font-monospace">SETUP50</span> for 50 RON off).</p>

                    <div class="input-group mb-2">
                        <span class="input-group-text bg-dark border-secondary border-opacity-50 text-mint">
                            <i class="bi bi-tag-fill"></i>
                        </span>
                        <input type="text" id="discountCodeInput" class="form-control form-control-nexus" placeholder="Enter coupon code (e.g. NEXUS10)" value="@Model.AppliedDiscountCode" />
                        <button type="button" id="btnApplyDiscount" class="btn btn-tech px-4 fw-bold">Apply</button>
                    </div>

                    <!-- Hidden input to submit with the form -->
                    <input type="hidden" name="DiscountCode" id="hiddenDiscountCode" value="@Model.AppliedDiscountCode" />

                    <!-- Live AJAX Feedback -->
                    <div id="discountFeedbackContainer" class="mt-3" style="display: @(string.IsNullOrWhiteSpace(Model.AppliedDiscountCode) ? "none" : "block");">
                        <div id="discountFeedback" class="rounded p-2 px-3 d-flex justify-content-between align-items-center" style="background-color: rgba(0, 229, 163, 0.12); border: 1px solid #00E5A3;">
                            <div class="d-flex align-items-center gap-2 text-white small">
                                <i class="bi bi-check-circle-fill text-mint fs-6"></i>
                                <span id="discountFeedbackText">Voucher applied: <strong class="text-mint font-monospace">@Model.AppliedDiscountCode</strong> (-@Model.DiscountAmount.ToString("N2") RON)</span>
                            </div>
                            <button type="button" id="btnRemoveDiscount" class="btn btn-link text-danger p-0 ms-2 text-decoration-none" title="Remove coupon">
                                <i class="bi bi-x-circle-fill fs-5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Sticky Order Summary & CTA -->
            <div class="col-lg-4">
                <div class="nexus-card-static p-4 sticky-top" style="top: 90px;">
                    <h3 class="h5 fw-bold text-white mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-receipt text-mint"></i> Order Review
                    </h3>

                    <!-- Order Items Preview -->
                    <div class="mb-3 pe-1" style="max-height: 240px; overflow-y: auto; overflow-x: hidden;">
                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom border-secondary border-opacity-25">
                                <img src="@item.ImageUrl" alt="@item.ProductName" class="rounded bg-dark p-1 flex-shrink-0" style="width: 50px; height: 50px; object-fit: cover;" />
                                <div class="flex-grow-1 min-w-0" style="overflow: hidden;">
                                    <div class="text-white small fw-bold text-truncate" title="@item.ProductName">@item.ProductName</div>
                                    <div class="text-muted small">Qty: @item.Quantity × @item.UnitPrice.ToString("N2") RON</div>
                                </div>
                                <div class="text-end text-white fw-bold small flex-shrink-0">
                                    @item.LineTotal.ToString("N2") RON
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Calculation Breakdown -->
                    <div class="d-flex justify-content-between text-muted mb-2">
                        <span>Items Subtotal</span>
                        <span id="summarySubtotal" data-subtotal="@Model.Subtotal.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="text-white fw-bold">@Model.Subtotal.ToString("N2") RON</span>
                    </div>

                    <div class="d-flex justify-content-between text-muted mb-2">
                        <span>Delivery Fee</span>
                        <span id="summaryShippingFee">
                            @if (Model.ShippingCost == 0)
                            {
                                <span class="badge badge-mint fw-bold">FREE</span>
                            }
                            else
                            {
                                <span class="text-white fw-bold">@Model.ShippingCost.ToString("N2") RON</span>
                            }
                        </span>
                    </div>

                    <div id="summaryDiscountRow" class="d-flex justify-content-between text-mint mb-2" style="display: @(Model.DiscountAmount > 0 ? "flex" : "none") !important;">
                        <span><i class="bi bi-tag-fill me-1"></i> Discount</span>
                        <span id="summaryDiscount" data-discount="@Model.DiscountAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="fw-bold">-@Model.DiscountAmount.ToString("N2") RON</span>
                    </div>

                    <div class="d-flex justify-content-between text-muted small mb-3">
                        <span>Includes 19% Romanian VAT</span>
                        <span id="summaryVat">@Model.EstimatedVat.ToString("N2") RON</span>
                    </div>

                    <hr class="border-secondary border-opacity-50 my-3" />

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="h6 fw-bold text-white mb-0">Total to Pay</span>
                        <span id="summaryGrandTotal" class="h4 fw-bold text-mint mb-0">
                            @Model.GrandTotal.ToString("N2") <span class="fs-6 text-white">RON</span>
                        </span>
                    </div>

                    <!-- Place Order Button -->
                    <button type="submit" id="btnPlaceOrder" class="btn btn-tech w-100 py-3 fw-bold fs-6">
                        <i class="bi bi-check2-circle me-1"></i> Place Order (Unpaid Sandbox)
                    </button>

                    <p class="text-center text-muted small mt-2 mb-0" style="font-size: 0.78rem;">
                        <i class="bi bi-info-circle me-1"></i> Orders are saved with status <code>Unpaid</code> awaiting Stripe test mode settlement.
                    </p>

                    <!-- Trust Badges -->
                    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 small text-muted">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-shield-check text-mint"></i>
                            <span>End-to-end Encrypted Transaction</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-truck text-info"></i>
                            <span>Dispatched via Tracked Priority Courier</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-patch-check text-warning"></i>
                            <span>Official 24-Month Hardware Warranty</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
