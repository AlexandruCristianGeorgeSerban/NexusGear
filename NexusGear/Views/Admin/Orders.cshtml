@model NexusGear.ViewModels.AdminOrderListViewModel
@{
    ViewData["Title"] = "Order Queue & Fulfillment — NexusGear Admin";
}

<div class="container py-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 py-2">
            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none text-muted">Admin Dashboard</a></li>
            <li class="breadcrumb-item active text-mint" aria-current="page">Orders Management</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="nexus-card-static p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h1 class="h3 fw-bold text-white mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-box-seam text-mint"></i> Customer Orders Queue
                </h1>
                <p class="text-muted small mb-0">Track order processing, update courier fulfillment progression, and manage cancellations.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Dashboard
                </a>
                <a asp-action="Products" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-cpu me-1"></i> Products
                </a>
                <a asp-action="Categories" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-tags me-1"></i> Categories
                </a>
                <a asp-action="Reviews" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-chat-square-quote me-1"></i> Reviews
                </a>
            </div>
        </div>

        <!-- Filter Bar & Search -->
        <div class="row g-3 align-items-center mt-3 pt-3 border-top border-secondary border-opacity-25">
            <!-- Filter Pills -->
            <div class="col-lg-7">
                <div class="d-flex flex-wrap gap-2">
                    @{
                        var filters = new[] { "All", "Unpaid", "Paid", "Shipped", "Delivered", "Cancelled" };
                    }
                    @foreach (var filter in filters)
                    {
                        bool isActive = string.Equals(Model.StatusFilter, filter, StringComparison.OrdinalIgnoreCase);
                        <a asp-action="Orders" asp-route-status="@filter" asp-route-search="@Model.SearchTerm"
                           class="btn btn-sm @(isActive ? "btn-tech" : "btn-outline-secondary text-muted") py-1 px-3 rounded-pill fw-medium">
                            @filter
                        </a>
                    }
                </div>
            </div>

            <!-- Search Form -->
            <div class="col-lg-5">
                <form method="get" asp-action="Orders" class="d-flex gap-2">
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-nexus form-control-sm" placeholder="Search order # or email..." />
                    <button type="submit" class="btn btn-tech btn-sm px-3">
                        <i class="bi bi-search"></i>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a asp-action="Orders" asp-route-status="@Model.StatusFilter" class="btn btn-outline-danger btn-sm" title="Clear Search">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </form>
            </div>
        </div>
    </div>

    <!-- Orders Table -->
    @if (!Model.Orders.Any())
    {
        <div class="nexus-card-static p-5 text-center">
            <i class="bi bi-inbox text-muted display-4 d-block mb-3"></i>
            <h5 class="text-white fw-bold mb-2">No orders found</h5>
            <p class="text-muted small mb-0">No customer orders match the applied status filter or search parameters.</p>
        </div>
    }
    else
    {
        <div class="nexus-card-static p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted small">Showing <strong>@Model.Orders.Count</strong> order(s)</span>
            </div>

            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-muted small border-secondary">
                        <tr>
                            <th>Order Reference</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Courier</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td>
                                    <span class="font-monospace fw-bold text-mint">@order.OrderNumber</span>
                                </td>
                                <td class="text-muted small">
                                    @order.OrderDate.ToString("dd MMM yyyy, HH:mm")
                                </td>
                                <td>
                                    <div class="text-white fw-medium">@order.CustomerName</div>
                                    <span class="text-muted very-small" style="font-size: 0.75rem;">@order.CustomerEmail</span>
                                </td>
                                <td class="small text-muted">
                                    @order.ShippingMethod
                                </td>
                                <td class="text-white small fw-bold">
                                    @order.ItemCount unit(s)
                                </td>
                                <td class="font-monospace fw-bold text-mint">
                                    @order.TotalAmount.ToString("N2") RON
                                </td>
                                <td>
                                    @if (order.Status == "Paid")
                                    {
                                        <span class="badge bg-success text-white">Paid</span>
                                    }
                                    else if (order.Status == "Shipped")
                                    {
                                        <span class="badge bg-info text-dark">Shipped</span>
                                    }
                                    else if (order.Status == "Delivered")
                                    {
                                        <span class="badge bg-primary text-white">Delivered</span>
                                    }
                                    else if (order.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger text-white">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Unpaid</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="OrderDetails" asp-route-id="@order.OrderId" class="btn btn-outline-mint btn-sm py-1 px-3 fw-bold">
                                        Manage <i class="bi bi-chevron-right ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
