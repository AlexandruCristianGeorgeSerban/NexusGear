@model NexusGear.ViewModels.AdminCategoryListViewModel
@{
    ViewData["Title"] = "Category Hierarchy & Taxonomy — NexusGear Admin";
}

<div class="container py-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 py-2">
            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none text-muted">Admin Dashboard</a></li>
            <li class="breadcrumb-item active text-mint" aria-current="page">Category Management</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="nexus-card-static p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h1 class="h3 fw-bold text-white mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-tags text-mint"></i> Category Hierarchy &amp; Taxonomy
                </h1>
                <p class="text-muted small mb-0">Organize store hardware into taxonomy groups, manage URL slugs, and inspect product associations.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Dashboard
                </a>
                <a asp-action="Products" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-cpu me-1"></i> Products
                </a>
                <a asp-action="CreateCategory" class="btn btn-tech btn-sm fw-bold">
                    <i class="bi bi-plus-lg me-1"></i> Add Category
                </a>
            </div>
        </div>
    </div>

    <!-- Categories Table -->
    @if (!Model.Categories.Any())
    {
        <div class="nexus-card-static p-5 text-center">
            <i class="bi bi-tags text-muted display-4 d-block mb-3"></i>
            <h5 class="text-white fw-bold mb-2">No categories defined</h5>
            <p class="text-muted small mb-3">The store catalog currently has no category groups.</p>
            <a asp-action="CreateCategory" class="btn btn-tech btn-sm fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Create First Category
            </a>
        </div>
    }
    else
    {
        <div class="nexus-card-static p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead style="background-color: #0f172a; border-bottom: 1px solid rgba(148, 163, 184, 0.2);">
                        <tr class="text-muted small text-uppercase">
                            <th scope="col" class="ps-4 py-3">Category Details</th>
                            <th scope="col" class="py-3">URL Slug</th>
                            <th scope="col" class="py-3">Description</th>
                            <th scope="col" class="py-3 text-center">Assigned Products</th>
                            <th scope="col" class="pe-4 py-3 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cat in Model.Categories)
                        {
                            <tr style="border-bottom: 1px solid rgba(148, 163, 184, 0.1);">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 rounded bg-dark border border-secondary border-opacity-25 text-mint">
                                            <i class="bi bi-tag-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-white">@cat.Name</div>
                                            <span class="text-muted very-small" style="font-size: 0.75rem;">ID: #@cat.CategoryId</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <code class="font-monospace text-mint px-2 py-1 rounded bg-dark border border-secondary border-opacity-25" style="font-size: 0.85rem;">/@cat.Slug</code>
                                </td>
                                <td class="py-3 text-muted small" style="max-width: 320px;">
                                    @(string.IsNullOrWhiteSpace(cat.Description) ? "No description provided." : cat.Description)
                                </td>
                                <td class="py-3 text-center">
                                    <a asp-action="Products" asp-route-categoryId="@cat.CategoryId"
                                       class="badge @(cat.ProductCount > 0 ? "bg-dark border border-secondary text-info" : "bg-dark border border-secondary text-muted") text-decoration-none px-3 py-2">
                                        <i class="bi bi-box-seam me-1"></i> @cat.ProductCount @(cat.ProductCount == 1 ? "Product" : "Products")
                                    </a>
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="EditCategory" asp-route-id="@cat.CategoryId" class="btn btn-outline-light btn-sm" title="Edit Category">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        @if (cat.ProductCount == 0)
                                        {
                                            <form method="post" asp-action="DeleteCategory" asp-route-id="@cat.CategoryId" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to permanently delete category \'@cat.Name\'?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Category">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm opacity-50" disabled
                                                    title="Cannot delete category containing active products. Reassign or delete products first.">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-3 bg-dark border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                <span class="text-muted small">Total Taxonomies: <strong class="text-white">@Model.TotalCategoriesCount</strong></span>
                <span class="text-muted very-small" style="font-size: 0.75rem;">EF Core Referential Restrict protects populated categories from accidental deletion.</span>
            </div>
        </div>
    }
</div>
