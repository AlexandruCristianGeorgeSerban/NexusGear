@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="nexus-card-static p-5">
                <div class="d-inline-flex align-items-center justify-content-center p-4 rounded-circle bg-dark border border-danger border-opacity-50 mb-3 shadow">
                    <i class="bi bi-shield-x fs-1 text-danger"></i>
                </div>
                <h1 class="h3 fw-bold text-white mb-2">Access Restricted</h1>
                <p class="text-muted mb-4 lead fs-6">
                    You do not possess the required permissions or administrative privileges to view this portal area.
                </p>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-mint px-4 py-2">
                        <i class="bi bi-house-door-fill me-1"></i> Return Home
                    </a>
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-tech px-4 py-2">
                        <i class="bi bi-grid-fill me-1"></i> Hardware Catalog
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

