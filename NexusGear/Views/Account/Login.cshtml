@model NexusGear.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <!-- Sign In Card -->
            <div class="nexus-card-static p-4 p-sm-5">
                <!-- Brand Header -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-dark border border-secondary border-opacity-50 mb-3 shadow" style="width: 64px; height: 64px;">
                        <i class="bi bi-person-fill-lock fs-2 text-mint"></i>
                    </div>
                    <h1 class="h3 fw-bold text-white mb-1">Sign In to <span class="brand-text-accent">NexusGear</span></h1>
                    <p class="text-muted small mb-0">Access your desk hardware setups, orders, and verified reviews.</p>
                </div>

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="nexus-alert nexus-alert-danger mb-4" role="alert"></div>

                <form method="post" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Email Input -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label-nexus">
                            <i class="bi bi-envelope-fill me-1 text-info"></i> Email Address
                        </label>
                        <input asp-for="Email" class="form-control form-control-nexus" placeholder="name@example.com" autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label-nexus">
                                <i class="bi bi-shield-lock-fill me-1 text-info"></i> Password
                            </label>
                        </div>
                        <input asp-for="Password" class="form-control form-control-nexus" placeholder="••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Remember Me Checkbox -->
                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">
                            Remember this browser for 14 days
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-mint w-100 py-2.5 fw-bold mb-3 shadow">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <!-- Academic Evaluation / Demo Credentials Box -->
                <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-50 mt-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-info-circle-fill text-warning"></i>
                        <span class="text-white small fw-bold">Evaluation Demo Accounts (BCrypt)</span>
                    </div>
                    <div class="d-flex flex-column gap-1 small text-muted">
                        <div>
                            <strong class="text-info">Customer:</strong> <code class="text-white">customer@nexusgear.ro</code> / <code class="text-mint">Customer123!</code>
                        </div>
                        <div>
                            <strong class="text-warning">Admin:</strong> <code class="text-white">admin@nexusgear.ro</code> / <code class="text-mint">Admin123!</code>
                        </div>
                    </div>
                </div>

                <!-- Footer Link -->
                <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <p class="text-muted small mb-0">
                        New customer? 
                        <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-mint fw-bold text-decoration-none">
                            Create a free account
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

