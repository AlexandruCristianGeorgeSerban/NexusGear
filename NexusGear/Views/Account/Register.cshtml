@model NexusGear.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <!-- Registration Card -->
            <div class="nexus-card-static p-4 p-sm-5">
                <!-- Brand Header -->
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-dark border border-secondary border-opacity-50 mb-3 shadow" style="width: 64px; height: 64px;">
                        <i class="bi bi-person-plus-fill fs-2 text-mint"></i>
                    </div>
                    <h1 class="h3 fw-bold text-white mb-1">Create Your Account</h1>
                    <p class="text-muted small mb-0">Join the NexusGear community for curated hardware &amp; verified reviews.</p>
                </div>

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="nexus-alert nexus-alert-danger mb-4" role="alert"></div>

                <form method="post" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label-nexus">
                            <i class="bi bi-person-badge-fill me-1 text-info"></i> Full Name
                        </label>
                        <input asp-for="FullName" class="form-control form-control-nexus" placeholder="Alexandru Popescu" autocomplete="name" />
                        <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label-nexus">
                            <i class="bi bi-envelope-fill me-1 text-info"></i> Email Address
                        </label>
                        <input asp-for="Email" class="form-control form-control-nexus" placeholder="name@example.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Password -->
                        <div class="col-12 col-sm-6">
                            <label asp-for="Password" class="form-label-nexus">
                                <i class="bi bi-shield-lock-fill me-1 text-info"></i> Password
                            </label>
                            <input asp-for="Password" class="form-control form-control-nexus" placeholder="••••••••" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="col-12 col-sm-6">
                            <label asp-for="ConfirmPassword" class="form-label-nexus">
                                <i class="bi bi-shield-check me-1 text-info"></i> Confirm Password
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-nexus" placeholder="••••••••" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <p class="text-muted small mb-3">
                        <i class="bi bi-info-circle me-1"></i> Passwords are salted and secured with <strong class="text-white">BCrypt</strong>. Minimum 6 characters.
                    </p>

                    <!-- Terms & Privacy Checkbox -->
                    <div class="form-check mb-4">
                        <input asp-for="AcceptTerms" class="form-check-input" />
                        <label asp-for="AcceptTerms" class="form-check-label text-muted small">
                            I accept the <a asp-controller="Home" asp-action="Privacy" target="_blank" class="text-mint text-decoration-none">Privacy Policy</a> and agree to data handling under EU GDPR standards.
                        </label>
                        <span asp-validation-for="AcceptTerms" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-mint w-100 py-2.5 fw-bold mb-3 shadow">
                        <i class="bi bi-check-circle-fill me-1"></i> Register Account
                    </button>
                </form>

                <!-- Footer Link -->
                <div class="text-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <p class="text-muted small mb-0">
                        Already have an account? 
                        <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-mint fw-bold text-decoration-none">
                            Sign in here
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

