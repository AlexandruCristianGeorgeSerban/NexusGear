<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")NexusGear | Performance Desk Hardware</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css" />
    
    <!-- NexusGear Custom Dark Tech Design System (A11 Responsive 360px+) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Anti-Forgery Token for AJAX Requests -->
    @Html.AntiForgeryToken()

    <!-- Main Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-nexus">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand navbar-brand-nexus" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.svg" alt="NexusGear Logo" class="brand-logo" />
                    <span>NEXUS<span class="brand-text-accent">GEAR</span></span>
                </a>

                <!-- Mobile Action Toggles (Cart & Hamburger) -->
                <div class="d-flex align-items-center gap-2 d-lg-none ms-auto me-2">
                    <a asp-controller="Cart" asp-action="Index" class="btn-icon-nexus position-relative" aria-label="Cart">
                        <i class="bi bi-cart3 fs-5 text-mint"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge badge-mint cart-badge d-none">0</span>
                    </a>
                </div>

                <button class="navbar-toggler text-white border-0 p-1" type="button" data-bs-toggle="collapse" data-bs-target="#nexusNavbar" aria-controls="nexusNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-white"></i>
                </button>

                <!-- Collapsible Navbar Content -->
                <div class="collapse navbar-collapse" id="nexusNavbar">
                    <!-- Navigation Links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link nav-link-nexus" asp-controller="Catalog" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap-fill text-mint"></i> Catalog
                            </a>
                        </li>
                    </ul>

                    <!-- Search Form (A2 - Case-Insensitive Name Search) -->
                    <form class="header-search me-lg-3 my-2 my-lg-0" method="get" asp-controller="Catalog" asp-action="Index">
                        <i class="bi bi-search search-icon"></i>
                        <input class="form-control" type="search" name="searchTerm" placeholder="Search gear (e.g. K-75, 8K)..." value="@(Context.Request.Query["searchTerm"])" aria-label="Search" />
                    </form>

                    <!-- Right-side Action Icons (Wishlist, Cart, Account) -->
                    <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                        <!-- Wishlist Button (B7) -->
                        <a asp-controller="Wishlist" asp-action="Index" class="btn-icon-nexus position-relative" title="Saved Favorites">
                            <i class="bi bi-heart fs-6 text-danger"></i>
                            <span class="btn-label d-none d-xl-inline">Wishlist</span>
                            <span class="position-absolute top-0 start-100 translate-middle badge badge-blue wishlist-badge d-none">0</span>
                        </a>

                        <!-- Cart Button (A3) -->
                        <a asp-controller="Cart" asp-action="Index" class="btn-icon-nexus position-relative d-none d-lg-inline-flex" title="Shopping Cart">
                            <i class="bi bi-cart3 fs-6 text-mint"></i>
                            <span class="btn-label">Cart</span>
                            <span class="position-absolute top-0 start-100 translate-middle badge badge-mint cart-badge d-none">0</span>
                        </a>

                        <!-- Authentication / Profile Dropdown (A4) -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-icon-nexus dropdown-toggle" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-6 text-info"></i>
                                    <span class="btn-label text-truncate" style="max-width: 130px;">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end bg-dark border-secondary mt-2 shadow" aria-labelledby="userMenuDropdown">
                                    <li class="px-3 py-2 border-bottom border-secondary text-muted small">
                                        Signed in as: <strong class="text-white d-block text-truncate">@User.Identity.Name</strong>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 text-warning fw-bold" asp-controller="Admin" asp-action="Dashboard">
                                                <i class="bi bi-shield-lock-fill me-2"></i> Admin Portal
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider border-secondary" /></li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-gear me-2 text-info"></i> My Profile & Addresses
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Orders" asp-action="Index">
                                            <i class="bi bi-bag-check me-2 text-info"></i> Order History
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Wishlist" asp-action="Index">
                                            <i class="bi bi-heart me-2 text-danger"></i> Wishlist
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider border-secondary" /></li>
                                    <li>
                                        <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-2">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-tech py-1 px-3">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-mint py-1 px-3">
                                    Register
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alert Banners -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="nexus-alert nexus-alert-success" role="alert">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="nexus-alert nexus-alert-danger" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Dynamic Content -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- Toast Notification Anchor (AJAX alerts) -->
    <div id="nexus-toast-container"></div>

    <!-- Pinned Sticky Footer (A11 Responsive) -->
    <footer class="footer-nexus">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <img src="~/images/logo.svg" alt="NexusGear Logo" style="height: 28px;" />
                        <span class="fw-bold text-white fs-5">NEXUS<span class="brand-text-accent">GEAR</span></span>
                    </div>
                    <p class="small pe-md-4">
                        A curated home for high-performance gaming peripherals and ergonomic desk setups. Engineered for precision, built for endurance.
                    </p>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <span class="footer-tag text-info">.NET 10.0</span>
                        <span class="footer-tag text-mint">EF Core SQLite</span>
                        <span class="footer-tag text-warning">Stripe Sandbox</span>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Hardware</h6>
                    <ul>
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-category="mechanical-keyboards">Keyboards</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-category="gaming-mice">Mice</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-category="deskmats-mousepads">Deskmats</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index" asp-route-category="ergonomic-gaming-chairs">Chairs</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6>Customer Hub</h6>
                    <ul>
                        <li><a asp-controller="Account" asp-action="Profile">My Account</a></li>
                        <li><a asp-controller="Orders" asp-action="Index">Order Tracking</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Shopping Cart</a></li>
                        <li><a asp-controller="Wishlist" asp-action="Index">Saved Favorites</a></li>
                    </ul>
                </div>
                <div class="col-12 col-md-3">
                    <h6>Academic Project</h6>
                    <p class="small mb-2">
                        E-Commerce Course &bull; Academic Year 2026&ndash;2027
                    </p>
                    <p class="small mb-1">
                        <strong class="text-white">Popa-Ion Andrei</strong> &bull; Frontend Lead<br />
                        <strong class="text-white">Șerban Alexandru-Cristian-George</strong> &bull; Backend Lead
                    </p>
                    <div class="mt-2 small text-secondary">
                        &copy; 2026 NexusGear Labs. All rights reserved.
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
