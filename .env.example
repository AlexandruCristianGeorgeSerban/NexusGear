# ==============================================================================
# NexusGear Environment Configuration Template (.env.example)
# Copy this file to .env for local development overrides.
# ==============================================================================

# Database Connection (SQLite)
ConnectionStrings__DefaultConnection=Data Source=nexusgear.db

# Stripe Sandbox / Test API Credentials
# Leave as placeholder values to use the built-in local Payment Simulator
Stripe__PublishableKey=pk_test_placeholder_key_for_nexusgear
Stripe__SecretKey=sk_test_placeholder_key_for_nexusgear
Stripe__WebhookSecret=whsec_placeholder_webhook_secret_for_nexusgear

# SMTP Mailtrap Configuration for Transactional Order Confirmation Emails
Smtp__Host=sandbox.smtp.mailtrap.io
Smtp__Port=2525
Smtp__Username=placeholder_mailtrap_username
Smtp__Password=placeholder_mailtrap_password
Smtp__FromEmail=noreply@nexusgear.ro
Smtp__FromName=NexusGear Orders

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

